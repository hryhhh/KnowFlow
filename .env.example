# ============================================
# KnowBase X - 环境变量配置模板
# 复制为 .env 并修改实际值
# ============================================

# ---- PostgreSQL 向量数据库 ----
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=knowledge_rag

# ---- Redis 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 数据库连接串 (TypeORM / PGVector 共用) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=knowledge_rag

# ---- SSL 连接（生产环境设为 true）----
DATABASE_SSL=false

# ---- LLM 服务 (OpenAI 兼容接口) ----
LLM_API_KEY=sk-xxxxxxx
LLM_BASE_URL=https://ws-y6p6h63wplx9ccmu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# ---- 向量维度 (需与 Embedding 模型输出一致) ----
EMBEDDING_DIMENSIONS=1024

# ---- 应用端口 ----
SERVER_PORT=3000
FRONTEND_DEV_PORT=5173

# ---- 切片默认参数 ----
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# ---- 检索默认参数 ----
DEFAULT_TOP_K=10
DEFAULT_MIN_SCORE=0.70
DEFAULT_DENSE_WEIGHT=0.50

# ---- API 安全 ----
API_KEY_PREFIX=ek_

# ---- CORS（生产环境填写前端域名，逗号分隔；留空则允许所有来源）----
CORS_ALLOWED_ORIGINS=

# ---- 文件上传限制（MB）----
MAX_UPLOAD_SIZE_MB=100
