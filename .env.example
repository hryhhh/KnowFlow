# ============================================
# KnowBase X - 环境变量配置模板
# 复制为 .env 并修改实际值
# ============================================

# ---- PostgreSQL 向量数据库 ----
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_rag

# ---- Redis 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 数据库连接串 (TypeORM / PGVector 共用) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_NAME=knowledge_rag

# ---- LLM 服务 (OpenAI 兼容接口) ----
LLM_API_KEY=sk-xxxxxxx
LLM_BASE_URL=https://ws-y6p6h63wplx9ccmu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# ---- 向量维度 (需与 Embedding 模型输出一致) ----
EMBEDDING_DIMENSIONS=1024

# ---- 应用端口 ----
SERVER_PORT=3000
FRONTEND_DEV_PORT=5173

# ---- 切片默认参数 ----
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# ---- 检索默认参数 ----
DEFAULT_TOP_K=10
DEFAULT_MIN_SCORE=0.70
DEFAULT_DENSE_WEIGHT=0.50

# ---- API 安全 ----
API_KEY_PREFIX=ek_

# ---- Agent 编排（AGENTS_ENABLED=true 时生效）----
AGENTS_ENABLED=false
ROUTER_RULES_PATH=config/router.rules.yml
AGENT_DEFAULT_TIMEOUT_MS=3000
AGENT_COMPOSE_STRATEGY=concat
AGENT_ROUTER_ALLOW_PARALLEL=true
AGENT_ROUTER_MAX_MATCHED_RULES=3

# ---- DB Query Agent ----
DB_READONLY_URL=postgresql://readonly_user:readonly_pass@localhost:5433/knowledge_rag
DB_QUERY_MAX_ROWS=100

# ---- Web Search Agent ----
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_CACHE_TTL_SECONDS=3600
WEB_SEARCH_PROVIDER_TIMEOUT_MS=5000
WEB_SEARCH_USE_REDIS=false
