# ============================================
# KnowBase X - 环境变量配置模板
# 复制为 .env 并修改实际值
#
# 维护约定（与代码同步）：
# - 键集与 apps/server/src/config/env.ts（集中配置 + validateEnv 启动校验）保持一致：
#   新增/删除键必须同时更新 env.ts 与 validateEnv，否则启动报错或静默失效
# - 只有"会随部署环境变化"的值才进 env；机制参数/业务默认值以代码常量形式就近定义
# ============================================

# ---- PostgreSQL 向量数据库（docker compose 基础设施容器使用）----
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=knowledge_rag

# ---- Redis 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 数据库连接（TypeORM / PGVector / DB Query Agent 共用）----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=knowledge_rag
# 生产环境如需 SSL 连接设为 true
DATABASE_SSL=false

# ---- LLM 服务（OpenAI 兼容接口；Embedding 复用同一凭据，无需单独配置）----
LLM_API_KEY=sk-xxxxxxx                                     # 必填，启动时校验
LLM_BASE_URL=https://your-llm-endpoint/compatible-mode/v1  # 必填，启动时校验
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
# 向量维度：需与 Embedding 模型输出及数据库向量列一致（启动时校验取值）
EMBEDDING_DIMENSIONS=1024

# ---- 应用端口 ----
SERVER_PORT=3000
FRONTEND_DEV_PORT=5173               # 前端 vite dev server 端口（vite.config.ts 读取）

# ---- CORS（生产环境填写前端域名，逗号分隔；留空则允许所有来源）----
CORS_ALLOWED_ORIGINS=

# ---- 检索默认参数 ----
DEFAULT_MIN_SCORE=0.70
DEFAULT_MIN_DENSE_SCORE=0.3          # hybrid 模式 dense 候选过滤阈值，留空表示不施加
DEFAULT_CANDIDATE_MULTIPLIER=3       # 每路候选倍数（硬上限 10）
RAG_RESULT_CACHE_TTL_MS=300000       # 检索结果缓存 TTL（毫秒），0 表示禁用

# ---- 限流 ----
API_RATE_LIMIT=60                    # 默认每分钟请求上限

# ---- 文件上传限制（MB）----
MAX_UPLOAD_SIZE_MB=100

# ---- 会话缓存 TTL（秒，可选，默认 60）----
SESSION_CACHE_TTL_SECONDS=60

# ---- 文档摄入队列（默认值见 apps/server ingestion.constants.ts）----
DOCUMENT_QUEUE_ATTEMPTS=3
DOCUMENT_QUEUE_BACKOFF_MS=2000
DOCUMENT_QUEUE_REMOVE_ON_COMPLETE=1000
DOCUMENT_QUEUE_REMOVE_ON_FAIL=100

# ---- DB Query Agent ----
DB_READONLY_URL=postgresql://postgres:change-me-in-production@127.0.0.1:5433/knowledge_rag

# ---- Web Search Agent ----
WEB_SEARCH_PROVIDER=tavily           # tavily | serper（启动时校验）
WEB_SEARCH_API_KEY=tvly-xxxxxxx      # 留空则 Web Search Agent 返回空结果
WEB_SEARCH_PROVIDER_TIMEOUT_MS=5000
WEB_SEARCH_CACHE_TTL_SECONDS=300

# ---- MinerU 文档解析（本地 API 与 compose 镜像名）----
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=pipeline
MINERU_EFFORT=medium
MINERU_IMAGE=kb-mineru:local
# Agent 轻量解析 API（免登录云端，≤10MB，≤20页，输出 Markdown only）
MINERU_AGENT_API_BASE_URL=https://mineru.net/api/v1/agent

# ---- 多 Agent 编排（AGENTS_ENABLED=true 时启用）----
AGENTS_ENABLED=false                 # 启用多 Agent 编排链路
AGENT_ALWAYS_INCLUDE_AGENTS=ragflow  # 强制包含的 Agent（逗号分隔）
AGENT_ROUTER_CONFIDENCE_THRESHOLD=70 # LLM 仲裁触发阈值（百分制）
AGENT_COMPOSE_STRATEGY=rag-priority  # rag-priority | concat | llm-summarize | rerank-and-merge
AGENT_ROUTER_ALLOW_PARALLEL=true     # 允许并行执行 Agent

# ---- AgentRuntime（AGENT_RUNTIME_ENABLED=true 时启用 ReAct 循环）----
AGENT_RUNTIME_ENABLED=false          # 默认 false，保持原有路由模式
AGENT_REACT_MAX_ROUNDS=5             # ReAct 最大推理轮数
AGENT_TRUNCATED_FINALIZE=true        # 达到轮数上限后追加一次无工具 LLM 收尾作答（false 则返回固定提示）
AGENT_RUNTIME_TIMEOUT_MS=30000       # AgentRuntime 整体超时（毫秒）
AGENT_LLM_STREAMING=true             # LLM 流式调用（答案逐字推送；false 回退非流式+模拟分块）
AGENT_LLM_STREAM_TIMEOUT_MS=60000    # 流式开始后的整体上限（毫秒）；首块等待仍受 AGENT_RUNTIME_TIMEOUT_MS 约束
AGENT_MEMORY_MAX_MESSAGES=6          # 注入对话历史的最新消息数
AGENT_TRACE_ENABLED=true             # 是否持久化 trace 到 DB
AGENT_RUNTIME_FALLBACK=true          # 失败时降级到 Orchestrator 路由链路
AGENT_LEGACY_TOOLS_ENABLED=false     # 注册 *_legacy 适配器工具（token 消耗大，默认关闭）
API_CALL_ALLOWED_DOMAINS=            # call_http_api 域名白名单（逗号分隔，留空不限公网域名）
API_CALL_ALLOW_PRIVATE=false         # 是否允许 call_http_api 访问私网/环回地址（默认禁止 SSRF）
# TOOL_TIMEOUT_<大写工具名>=8000     # 工具超时覆盖（可选，动态读取，见 packages/agents tool-executor）
