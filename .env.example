# ============================================
# KnowBase X - 环境变量配置模板
# 复制为 .env 并修改实际值
# ============================================

# ---- PostgreSQL 向量数据库 ----
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=knowledge_rag

# ---- Redis 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 文档摄入队列 ----
DOCUMENT_QUEUE_CONCURRENCY=2
DOCUMENT_QUEUE_ATTEMPTS=3
DOCUMENT_QUEUE_BACKOFF_MS=2000
DOCUMENT_QUEUE_REMOVE_ON_COMPLETE=1000
DOCUMENT_QUEUE_REMOVE_ON_FAIL=100

# ---- 数据库连接串 (TypeORM / PGVector 共用) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=knowledge_rag

# ---- SSL 连接（生产环境设为 true）----
DATABASE_SSL=false

# ---- LLM 服务 (OpenAI 兼容接口) ----
LLM_API_KEY=sk-xxxxxxx
LLM_BASE_URL=https://ws-y6p6h63wplx9ccmu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# ---- 向量维度 (需与 Embedding 模型输出一致) ----
EMBEDDING_DIMENSIONS=1024

# ---- 应用端口 ----
SERVER_PORT=3000
FRONTEND_DEV_PORT=5173

# ---- 切片默认参数 ----
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# ---- 检索默认参数 ----
DEFAULT_TOP_K=10
DEFAULT_MIN_SCORE=0.70
DEFAULT_DENSE_WEIGHT=0.50
DEFAULT_MIN_DENSE_SCORE=0.3         # hybrid 模式 dense 候选过滤阈值，null 表示不施加
DEFAULT_CANDIDATE_MULTIPLIER=3      # 每路候选倍数（硬上限 10）
RAG_RESULT_CACHE_TTL_MS=300000      # 检索结果缓存 TTL（毫秒），0 表示禁用

# ---- 限流 ----
API_RATE_LIMIT=60                   # 默认每分钟请求上限

# ---- API 安全 ----
API_KEY_PREFIX=ek_

# ---- CORS（生产环境填写前端域名，逗号分隔；留空则允许所有来源）----
CORS_ALLOWED_ORIGINS=

# ---- 文件上传限制（MB）----
MAX_UPLOAD_SIZE_MB=100

# ---- 多 Agent 编排（AGENTS_ENABLED=true 时启用）----
AGENTS_ENABLED=false                # 启用多 Agent 编排链路
AGENT_ALWAYS_INCLUDE_AGENTS=ragflow # 强制包含的 Agent（逗号分隔）
AGENT_ROUTER_CONFIDENCE_THRESHOLD=70 # LLM 仲裁触发阈值（百分制）
AGENT_COMPOSE_STRATEGY=rag-priority # 合成策略: rag-priority | concat | llm-summarize
AGENT_ROUTER_ALLOW_PARALLEL=true    # 允许并行执行 Agent

# ---- AgentRuntime（AGENT_RUNTIME_ENABLED=true 时启用 ReAct 循环）----
AGENT_RUNTIME_ENABLED=false         # 是否启用 AgentRuntime（默认 false，保持原有路由模式）
AGENT_REACT_MAX_ROUNDS=5            # ReAct 最大推理轮数（默认 5）
AGENT_RUNTIME_TIMEOUT_MS=30000      # AgentRuntime 整体超时（毫秒，默认 30s）
AGENT_MEMORY_MAX_MESSAGES=6         # 注入对话历史的最新消息数（默认 6）
AGENT_TRACE_ENABLED=true            # 是否持久化 trace 到 DB（默认 true）
AGENT_RUNTIME_FALLBACK=true         # AgentRuntime 失败时降级到 Orchestrator 路由链路（默认 true，置 false 关闭）
AGENT_LEGACY_TOOLS_ENABLED=false    # 注册 *_legacy 适配器工具给 LLM（默认 false；会嵌套完整 Agent 调用，token 消耗大）
API_CALL_ALLOWED_DOMAINS=           # call_http_api 域名白名单（逗号分隔，留空不限公网域名）
API_CALL_ALLOW_PRIVATE=false        # 是否允许 call_http_api 访问私网/环回地址（默认 false，禁止 SSRF）
# TOOL_TIMEOUT_RAG_SEARCH=8000      # 工具超时覆盖（可选，命名规则 TOOL_TIMEOUT_<大写工具名>，毫秒）

# ---- Web Search ----
WEB_SEARCH_CACHE_TTL_SECONDS=300    # Web Search 结果缓存 TTL（秒）
