{
  "compilerOptions": {
    "module": "esnext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  }
}
