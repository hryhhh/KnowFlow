# KnowBase X — 后端服务 Dockerfile
# 构建上下文：仓库根目录 (knowbase-x/)
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

# 仅复制依赖清单以利用层缓存
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/rag-engine/package.json packages/rag-engine/package.json
COPY packages/agents/package.json packages/agents/package.json
COPY apps/server/package.json apps/server/package.json
ENV CI=true
ENV TZ=UTC
ENV NODE_OPTIONS="--no-warnings"
RUN apk add --no-cache tzdata && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN pnpm install --frozen-lockfile

# 复制全部源码并构建
COPY . .
RUN pnpm --filter @knowbase-x/rag-engine build
RUN pnpm --filter @knowbase-x/agents build
RUN pnpm --filter @knowbase-x/server build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "apps/server/dist/main.js"]
