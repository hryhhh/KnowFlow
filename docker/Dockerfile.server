# Knowledge AI — 后端服务 Dockerfile
# 构建上下文：仓库根目录 (knowledge-ai/)
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

# 仅复制依赖清单以利用层缓存
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/knowledge-engine/package.json packages/knowledge-engine/package.json
COPY apps/server/package.json apps/server/package.json
RUN pnpm install --no-frozen-lockfile

# 复制全部源码并构建
COPY . .
RUN pnpm --filter @knowledge-ai/rag-engine build
RUN pnpm --filter @knowledge-ai/server build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "apps/server/dist/main.js"]
